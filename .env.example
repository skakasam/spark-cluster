# ======================================================================================================================
# .env.example — copy to .env and fill in values before running docker compose up
# ======================================================================================================================

# ======================================================================================================================
# Container Images & Build Arguments. These define the Docker images and build arguments for the respective services.
# ======================================================================================================================
POSTGRES_IMAGE=postgres:15
SPARK_IMAGE=novus/spark:3.5.8
HADOOP_VERSION=3.3.6

# ======================================================================================================================
# PostgreSQL based Hive Metastore JDBC Catalog Credentials & Database. These values should be set according to your 
# PostgreSQL setup, and are used by the Hive Metastore and Spark JDBC catalog configuration.
# ======================================================================================================================
POSTGRES_DB=your_metastore_database
POSTGRES_USER=your_pgsql_user_id
POSTGRES_PASSWORD=your_pgsql_password

# ======================================================================================================================
# Host Port Mappings. These define the ports on the host machine that will be mapped to the respective container ports.
# ======================================================================================================================
POSTGRES_PORT=5432
SPARK_MASTER_WEBUI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_DRIVER_PORT=7001
SPARK_BLOCKMANAGER_PORT=7002
SPARK_DRIVER_UI_PORTS=4040-4050
SPARK_WORKER1_WEBUI_PORT=8081
SPARK_WORKER2_WEBUI_PORT=8082
SPARK_WORKER3_WEBUI_PORT=8083
SPARK_HISTORY_UI_PORT=18080

# ======================================================================================================================
# Volume host bind locations. These directories will be mounted into the respective Docker containers.
# ======================================================================================================================
PROJECTS_DIR=D:/Projects/Spark/Projects
PGSQL_DATA_DIR=D:/Projects/Spark/PgSQL
CLUSTER_DATA_DIR=D:/Projects/Spark/Data
CLUSTER_EVENTS_DIR=D:/Projects/Spark/Events
CLUSTER_WAREHOUSE_DIR=D:/Projects/Spark/Warehouse

# ======================================================================================================================
# Container Resource Limits. These values define the CPU and memory limits for the respective Docker containers.
# ======================================================================================================================
POSTGRES_CPUS=2.0
POSTGRES_MEMORY=2g
SPARK_MASTER_CPUS=1.0
SPARK_MASTER_MEMORY=2g
SPARK_CLIENT_CPUS=2.0
SPARK_CLIENT_MEMORY=3g
SPARK_WORKER_CPUS=2.0
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3584m
SPARK_WORKER_MEMORY_LIMIT=4g
SPARK_HISTORY_CPUS=1.0
SPARK_HISTORY_MEMORY=2g
